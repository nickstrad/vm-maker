#!/usr/bin/env bash
# Runs the vendored kb CLI against this repo's own knowledge store (tools/kb), never the global one.
#
#   tools/kb/bin/kb-local search "how do I run the tests" --caller claude
#   KB_REBUILD=1 tools/kb/bin/kb-local version   # force a rebuild of the binary
#
# The binary is built on first use into tools/kb/.cache/kb (gitignored). Entries live in
# tools/kb/data/; the index and search log in tools/kb/.kb/kb.sqlite (gitignored, rebuildable
# with `kb-local reindex --all`).
set -euo pipefail

SELF=$(readlink -f "$0")
KB_DIR=$(cd "$(dirname "$SELF")/.." && pwd)
BIN="$KB_DIR/.cache/kb"

if [ ! -x "$BIN" ] || [ "${KB_REBUILD:-}" = "1" ]; then
  GO=$(command -v go || echo /usr/local/go/bin/go)
  [ -x "$GO" ] || { echo "kb-local: go is required to build kb (cgo + gcc)" >&2; exit 1; }
  mkdir -p "$KB_DIR/.cache"
  echo "kb-local: building $BIN (first cgo build can take ~2 minutes)" >&2
  (cd "$KB_DIR" && "$GO" build -tags fts5 -trimpath \
    -ldflags "-X main.version=vendored -X github.com/nickstrad/kb/internal/cli.defaultRoot=$KB_DIR" \
    -o "$BIN" ./cmd/kb)
fi

# Always override any inherited KB_ROOT (e.g. the droplet's global store).
export KB_ROOT="$KB_DIR"
exec "$BIN" "$@"
