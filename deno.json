{
  "name": "@vm-maker/cli",
  "version": "0.0.1",
  "exports": "./src/main.ts",
  "tasks": {
    "dev": "deno run --watch src/main.ts",
    "start": "deno run src/main.ts",
    "test": "deno test",
    "check": "deno fmt --check && deno lint && deno check src/",
    "compile": "deno compile --output bin/vm-maker src/main.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "effect": "npm:effect@^4.0.0",
    "fast-check": "npm:fast-check@^4"
  },
  "compilerOptions": {
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true
  },
  "fmt": {
    "lineWidth": 100
  },
  "exclude": [
    "docs/",
    "cloud-init/",
    ".worktrees/"
  ]
}
