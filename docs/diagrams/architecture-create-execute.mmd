%% draw-visual:
sequenceDiagram
  autonumber
  participant U as User
  participant CLI
  participant PLN as Planner
  participant EXE as Executor
  participant API as Provider API
  CLI->>PLN: ResolvedSpec
  PLN-->>CLI: Plan
  opt dry-run
    CLI-->>U: print plan, exit 0
  end
  CLI->>EXE: run Plan
  EXE->>API: request-id?
  Note over EXE,API: skip create if label found
  EXE->>API: POST create
  Note over EXE,API: labels + user-data
  loop every 2s, max 3m
    EXE->>API: GET status
  end
  alt running
    EXE-->>CLI: VmCreated
    CLI-->>U: VM id, IP
  else timeout
    EXE-->>CLI: ProvisionTimeout
    CLI-->>U: VM id, exit 9
  end
